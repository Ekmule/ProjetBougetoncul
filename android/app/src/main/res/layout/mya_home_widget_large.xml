<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mya_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mya_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/mya_widget_attention_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/mya_widget_today_badge"
            android:src="@drawable/mya_attention_ring_pulse"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mya_widget_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/mya_widget_description"
            android:scaleType="fitCenter"
            android:src="@drawable/mya_icon_01" />

        <ImageView
            android:id="@+id/mya_widget_sync_badge"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:contentDescription="@string/mya_widget_sync_badge"
            android:src="@drawable/mya_sync_badge"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mya_widget_today_badge"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@string/mya_widget_today_badge"
            android:src="@drawable/mya_today_attention_badge"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mya_widget_section_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mya_widget_section_today"
            android:textColor="#FFB300"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mya_widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/mya_widget_idle_hint"
            android:textColor="#F5F5F5"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
